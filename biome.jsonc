{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/core", "ultracite/next", "ultracite/react"],
  "files": {
    "includes": [
      "!public",
      "!components/ui",
      "!hooks/use-mobile.ts",
      "!.source",
      // Drizzle writes these: the SQL, the journal and the snapshots are
      // regenerated by `db:generate`, so formatting them is undone on the
      // next schema change.
      "!migrations"
    ]
  }
}
